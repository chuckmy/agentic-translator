LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-5.4-mini

# --- v0.10.x: Model / Engine storage (optional; defaults to ./models, ./engines) ---
# AT_MODELS_DIR=/path/to/your/models
# AT_ENGINES_DIR=/path/to/your/engines

# --- v0.10.1: Company-shared deployment (Tailscale-fronted server etc.) ---
# When 1, the BYOK sidebar is hidden; the server-side ANTHROPIC_API_KEY /
# OPENAI_API_KEY above is used silently for every translator session.
# See docs/deploy-tailscale.md.
# AT_COMPANY_MODE=0
